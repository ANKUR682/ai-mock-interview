rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidInterview(data) {
      return data.keys().hasAll(['userId', 'jobTitle', 'status', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.jobTitle is string && data.jobTitle.size() <= 150 &&
        (data.status == 'in_progress' || data.status == 'completed') &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('jobDescription' in data) || (data.jobDescription is string && data.jobDescription.size() <= 5000)) &&
        (!('yearsOfExperience' in data) || (data.yearsOfExperience is string && data.yearsOfExperience.size() <= 50)) &&
        (!('questions' in data) || data.questions is list) &&
        (!('answers' in data) || data.answers is list) &&
        (!('evaluation' in data) || data.evaluation is map);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000));
    }

    // Interviews Collection
    match /interviews/{interviewId} {
      allow get: if isSignedIn() && isValidId(interviewId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(interviewId) && incoming().userId == request.auth.uid && isValidInterview(incoming());
      allow update: if isSignedIn() && isValidId(interviewId) && existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && isValidInterview(incoming());
      allow delete: if isSignedIn() && isValidId(interviewId) && existing().userId == request.auth.uid;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && incoming().uid == existing().uid && isValidUserProfile(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
